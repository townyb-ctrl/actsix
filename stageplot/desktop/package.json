{
  "name": "stageplot-desktop",
  "productName": "Stageplot",
  "version": "1.0.0",
  "description": "Stage plots, input lists and load-in checklists for church teams.",
  "main": "main.js",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "npm run prepare-app && electron .",
    "dist:mac": "npm run prepare-app && electron-builder --mac --publish never",
    "dist:win": "npm run prepare-app && electron-builder --win --publish never",
    "dist:linux": "npm run prepare-app && electron-builder --linux --publish never"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "app.stageplot.desktop",
    "productName": "Stageplot",
    "copyright": "Stageplot",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Stageplot-${version}-mac.${ext}"
    },
    "dmg": {
      "title": "Stageplot ${version}",
      "artifactName": "Stageplot-${version}-mac.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stageplot",
      "artifactName": "Stageplot-Setup-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility",
      "icon": "build/icon.png"
    },
    "publish": null
  }
}
